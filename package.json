{
  "name": "pdf-translate-wizard",
  "productName": "PDF Translate Wizard",
  "version": "0.1.0",
  "description": "Aplicativo desktop para tradução inteligente de PDFs preservando layout",
  "author": "PDF Translate Wizard",
  "license": "MIT",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "electron --vite",
    "build": "vite build && electron-builder",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "electron-store": "^8.2.0",
    "uuid": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/electron": "^1.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
